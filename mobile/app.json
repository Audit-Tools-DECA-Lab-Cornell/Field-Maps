{
  "expo": {
    "name": "FieldOps",
    "slug": "fieldops-mobile",
    "version": "0.1.0",
    "scheme": "fieldops",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fieldops.collector.dev",
      "requireFullScreen": true
    },
    "android": {
      "package": "com.fieldops.collector.dev"
    },
    "platforms": ["ios", "android"],
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "@maplibre/maplibre-react-native",
      "expo-secure-store",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "LANDSCAPE"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "backgroundColor": "#161826"
  }
}
