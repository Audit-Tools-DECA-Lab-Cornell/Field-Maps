# Copy to .env.local. Both values are public: NEXT_PUBLIC_ variables are compiled into the
# browser bundle, so never put a secret here.

# Origin of the FieldMaps API, with no trailing slash. Unset, the base map screen assembles a
# package and downloads it instead of claiming an upload.
#   local API:  http://127.0.0.1:8000
#   deployed:   https://api.example.org
NEXT_PUBLIC_FIELDMAPS_API_URL=http://127.0.0.1:8000
